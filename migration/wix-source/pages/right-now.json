    {
      "index": 1,
      "id": "comp-kc26lini",
      "text": "A physical exhibition, a website of imagery, and special online events!",
      "html": "<h4 class=\"font_4 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.2em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"font-family:brandon-grot-w01-light,sans-serif;\" class=\"wixui-rich-text__text\">A physical exhibition, a website of imagery, and special online events!</span></span></span></span></h4>",
