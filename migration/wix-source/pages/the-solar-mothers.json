      "html": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:26px; line-height:1.2em; text-align:center;\"><span style=\"color:#FFCBAA;\" class=\"wixui-rich-text__text\"><span style=\"font-size:26px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">At&nbsp;&nbsp;<span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\">Dream Farm&nbsp;Commons </span></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:26px; line-height:1.2em; text-align:center;\"><span style=\"color:#FFCBAA;\" class=\"wixui-rich-text__text\"><span style=\"font-size:26px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.05em;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">349 15th Street Oakland</span></span></span></span></p>",
